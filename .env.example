# =============================================================
# Forgejo + MariaDB — environment configuration
# =============================================================
# Copy this file to .env and fill in secrets before running install.sh
#   cp .env.example .env

# ---- Forgejo process user/group inside the container ----
USER_UID=1000
USER_GID=1000

# ---- MariaDB credentials ----
# These are consumed by the mariadb container on first start.
# Changing them after first start requires manual DB migration.
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_DATABASE=forgejo
MARIADB_USER=forgejo
MARIADB_PASSWORD=changeme_strong_password

# ---- Forgejo database connection (must match MariaDB credentials above) ----
FORGEJO__database__DB_TYPE=mysql
FORGEJO__database__HOST=localhost:3306
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__PASSWD=changeme_strong_password

# ---- Forgejo instance settings ----
# Set DOMAIN and ROOT_URL to the host IP or DNS name — never localhost.
FORGEJO__server__DOMAIN=192.168.10.41
FORGEJO__server__ROOT_URL=http://192.168.10.41:13400/
FORGEJO__server__SSH_DOMAIN=192.168.10.41
FORGEJO__server__SSH_PORT=13401
